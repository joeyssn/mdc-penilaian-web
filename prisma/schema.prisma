generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model evaluationlog {
  id                                String   @id @default(uuid())
  graderId                          String
  targetId                          String
  rubricId                          String
  createdAt                         DateTime @default(now())
  user_evaluationlog_graderIdTouser user     @relation("evaluationlog_graderIdTouser", fields: [graderId], references: [id], onDelete: Cascade, map: "EvaluationLog_graderId_fkey")
  rubric                            rubric   @relation(fields: [rubricId], references: [id], onDelete: Cascade, map: "EvaluationLog_rubricId_fkey")
  user_evaluationlog_targetIdTouser user     @relation("evaluationlog_targetIdTouser", fields: [targetId], references: [id], onDelete: Cascade, map: "EvaluationLog_targetId_fkey")

  @@unique([graderId, targetId, rubricId], map: "EvaluationLog_graderId_targetId_rubricId_key")
  @@index([rubricId], map: "EvaluationLog_rubricId_fkey")
  @@index([targetId], map: "EvaluationLog_targetId_fkey")
}

model rubric {
  id                    String                  @id @default(uuid())
  title                 String
  description           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  evaluatees            String?
  evaluators            String?
  intendedForRole       String                  @default("STUDENT")
  isSelfReflection      Boolean                 @default(false)
  schoolLevel           String                  @default("SMP_SMA")
  evaluationlog         evaluationlog[]
  rubriclevelassignment rubriclevelassignment[]
  rubricsection         rubricsection[]
}

model rubriccategory {
  id              String            @id @default(uuid())
  title           String
  order           Int
  sectionId       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  rubricsection   rubricsection     @relation(fields: [sectionId], references: [id], onDelete: Cascade, map: "RubricCategory_sectionId_fkey")
  rubricindicator rubricindicator[]

  @@index([sectionId], map: "RubricCategory_sectionId_fkey")
}

model rubricindicator {
  id             String         @id @default(uuid())
  text           String
  order          Int
  weight         Float          @default(1)
  categoryId     String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  rubriccategory rubriccategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "RubricIndicator_categoryId_fkey")
  score          score[]

  @@index([categoryId], map: "RubricIndicator_categoryId_fkey")
}

model rubricsection {
  id             String           @id @default(uuid())
  title          String
  order          Int
  rubricId       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  rubriccategory rubriccategory[]
  rubric         rubric           @relation(fields: [rubricId], references: [id], onDelete: Cascade, map: "RubricSection_rubricId_fkey")

  @@index([rubricId], map: "RubricSection_rubricId_fkey")
}

model score {
  id                        String          @id @default(uuid())
  value                     score_value
  targetId                  String
  graderId                  String
  indicatorId               String
  createdAt                 DateTime        @default(now())
  user_score_graderIdTouser user            @relation("score_graderIdTouser", fields: [graderId], references: [id], onDelete: Cascade, map: "Score_graderId_fkey")
  rubricindicator           rubricindicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade, map: "Score_indicatorId_fkey")
  user_score_targetIdTouser user            @relation("score_targetIdTouser", fields: [targetId], references: [id], onDelete: Cascade, map: "Score_targetId_fkey")

  @@unique([targetId, graderId, indicatorId], map: "Score_targetId_graderId_indicatorId_key")
  @@index([graderId], map: "Score_graderId_fkey")
  @@index([indicatorId], map: "Score_indicatorId_fkey")
}

model user {
  id                                                    String              @id @default(uuid())
  name                                                  String
  nis_niy                                               String              @unique(map: "User_nis_niy_key")
  password                                              String
  role                                                  user_role
  email                                                 String?
  gender                                                String?
  department                                            user_department?    @default(UMUM)
  grade                                                 Int?
  level                                                 String?
  className                                             String?
  division                                              String?
  evaluationlog_evaluationlog_graderIdTouser            evaluationlog[]     @relation("evaluationlog_graderIdTouser")
  evaluationlog_evaluationlog_targetIdTouser            evaluationlog[]     @relation("evaluationlog_targetIdTouser")
  score_score_graderIdTouser                            score[]             @relation("score_graderIdTouser")
  score_score_targetIdTouser                            score[]             @relation("score_targetIdTouser")
  sdevaluation_sdevaluation_evaluatorIdTouser           sdevaluation[]      @relation("sdevaluation_evaluatorIdTouser")
  sdevaluation_sdevaluation_targetIdTouser              sdevaluation[]      @relation("sdevaluation_targetIdTouser")
  studentassignment_studentassignment_studentIdTouser   studentassignment[] @relation("studentassignment_studentIdTouser")
  studentassignment_studentassignment_teacherIdTouser   studentassignment[] @relation("studentassignment_teacherIdTouser")
  teacherassignment_teacherassignment_evaluatorIdTouser teacherassignment[] @relation("teacherassignment_evaluatorIdTouser")
  teacherassignment_teacherassignment_teacherIdTouser   teacherassignment[] @relation("teacherassignment_teacherIdTouser")

  @@index([role])
}

model absence {
  id              String   @id
  userId          String
  userName        String
  role            String
  attendanceScore Float    @default(0)
  updatedAt       DateTime
}

model appsetting {
  key       String   @id
  value     String
  updatedAt DateTime
}

model auditlog {
  id         String   @id
  actorId    String
  actorName  String
  actorRole  String
  action     String
  entityType String
  entityId   String?
  detail     String?  @db.LongText
  createdAt  DateTime @default(now())

  @@index([actorId], map: "AuditLog_actorId_idx")
  @@index([entityType, entityId], map: "AuditLog_entityType_entityId_idx")
}

model evalperiod {
  id                String              @id
  name              String              @unique(map: "EvalPeriod_name_key")
  status            evalperiod_status   @default(DRAFT)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  sdevaluation      sdevaluation[]
  studentassignment studentassignment[]
  teacherassignment teacherassignment[]
}

model evaluationweight {
  id                String   @id
  studentWeight     Float    @default(20)
  peerWeight        Float    @default(20)
  selfWeight        Float    @default(20)
  observationWeight Float    @default(20)
  attendanceWeight  Float    @default(20)
  mainWeight        Float    @default(0)
  supervisorWeight  Float    @default(0)
  leaderWeight      Float    @default(0)
  updatedAt         DateTime
}

model observation {
  id               String   @id
  targetId         String
  targetName       String
  observerId       String
  observerName     String
  date             String
  kelas            String
  subject          String
  duration         String
  topic            String
  scores           String   @db.LongText
  notesPositive    String   @db.Text
  notesImprovement String   @db.Text
  finalScore       Float
  createdAt        DateTime @default(now())
  isApproved       Boolean  @default(false)
}

model observationtemplate {
  id      String @id
  content String @db.LongText
}

model performanceweight {
  id          String   @id
  factorKey   String   @unique(map: "PerformanceWeight_factorKey_key")
  displayName String
  weight      Float
  description String?
  updatedAt   DateTime
}

model rubriclevelassignment {
  id         String   @id
  rubricId   String
  level      String
  evaluators String?
  evaluatees String?
  updatedAt  DateTime
  rubric     rubric   @relation(fields: [rubricId], references: [id], onDelete: Cascade, map: "rubricLevelAssignment_rubricId_fkey")

  @@unique([rubricId, level], map: "rubricLevelAssignment_rubricId_level_key")
}

model sdevaluation {
  id                                  String             @id
  type                                sdevaluation_type
  periodId                            String
  evaluatorId                         String
  targetId                            String
  studentAssignmentId                 String?
  rubricId                            String
  answers                             String             @db.LongText
  average                             Float
  context                             String?            @db.LongText
  status                              String             @default("SUBMITTED")
  submittedAt                         DateTime           @default(now())
  assignmentId                        String?
  teacherassignment                   teacherassignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict, map: "SdEvaluation_assignmentId_fkey")
  user_sdevaluation_evaluatorIdTouser user               @relation("sdevaluation_evaluatorIdTouser", fields: [evaluatorId], references: [id], onDelete: Cascade, map: "SdEvaluation_evaluatorId_fkey")
  evalperiod                          evalperiod         @relation(fields: [periodId], references: [id], onDelete: Cascade, map: "SdEvaluation_periodId_fkey")
  studentassignment                   studentassignment? @relation(fields: [studentAssignmentId], references: [id], onDelete: Restrict, map: "SdEvaluation_studentAssignmentId_fkey")
  user_sdevaluation_targetIdTouser    user               @relation("sdevaluation_targetIdTouser", fields: [targetId], references: [id], onDelete: Cascade, map: "SdEvaluation_targetId_fkey")

  @@unique([type, periodId, evaluatorId, targetId], map: "SdEvaluation_type_periodId_evaluatorId_targetId_key")
  @@index([assignmentId], map: "SdEvaluation_assignmentId_fkey")
  @@index([evaluatorId], map: "SdEvaluation_evaluatorId_idx")
  @@index([periodId, type], map: "SdEvaluation_periodId_type_idx")
  @@index([studentAssignmentId], map: "SdEvaluation_studentAssignmentId_fkey")
  @@index([targetId], map: "SdEvaluation_targetId_idx")
}

model semesterarchive {
  id               String   @id
  semester         String
  targetId         String
  targetName       String
  targetRole       String
  scoresData       String?  @db.LongText
  evalLogsData     String?  @db.LongText
  observationsData String?  @db.LongText
  absenceData      String?  @db.LongText
  archivedAt       DateTime @default(now())
  labelsData       String?  @db.LongText
  sdData           String?  @db.LongText

  @@index([semester], map: "SemesterArchive_semester_idx")
  @@index([targetId], map: "SemesterArchive_targetId_idx")
}

model studentassignment {
  id                                     String         @id
  periodId                               String
  studentId                              String
  teacherId                              String
  assignedById                           String
  createdAt                              DateTime       @default(now())
  sdevaluation                           sdevaluation[]
  evalperiod                             evalperiod     @relation(fields: [periodId], references: [id], onDelete: Cascade, map: "StudentAssignment_periodId_fkey")
  user_studentassignment_studentIdTouser user           @relation("studentassignment_studentIdTouser", fields: [studentId], references: [id], onDelete: Cascade, map: "StudentAssignment_studentId_fkey")
  user_studentassignment_teacherIdTouser user           @relation("studentassignment_teacherIdTouser", fields: [teacherId], references: [id], onDelete: Cascade, map: "StudentAssignment_teacherId_fkey")

  @@unique([periodId, studentId, teacherId], map: "StudentAssignment_periodId_studentId_teacherId_key")
  @@index([studentId], map: "StudentAssignment_studentId_idx")
  @@index([teacherId], map: "StudentAssignment_teacherId_idx")
}

model teacherassignment {
  id                                       String                 @id
  periodId                                 String
  teacherId                                String
  evaluatorId                              String
  role                                     teacherassignment_role
  active                                   Boolean                @default(true)
  assignedById                             String
  createdAt                                DateTime               @default(now())
  updatedAt                                DateTime
  sdevaluation                             sdevaluation[]
  user_teacherassignment_evaluatorIdTouser user                   @relation("teacherassignment_evaluatorIdTouser", fields: [evaluatorId], references: [id], onDelete: Cascade, map: "TeacherAssignment_evaluatorId_fkey")
  evalperiod                               evalperiod             @relation(fields: [periodId], references: [id], onDelete: Cascade, map: "TeacherAssignment_periodId_fkey")
  user_teacherassignment_teacherIdTouser   user                   @relation("teacherassignment_teacherIdTouser", fields: [teacherId], references: [id], onDelete: Cascade, map: "TeacherAssignment_teacherId_fkey")

  @@unique([periodId, teacherId, evaluatorId, role], map: "TeacherAssignment_periodId_teacherId_evaluatorId_role_key")
  @@index([evaluatorId], map: "TeacherAssignment_evaluatorId_idx")
  @@index([teacherId], map: "TeacherAssignment_teacherId_idx")
}

enum user_department {
  IPA
  IPS
  UMUM
}

enum score_value {
  A
  B
  C
  D
}

enum user_role {
  ADMIN
  DIRECTOR
  PRINCIPAL
  VICE_PRINCIPAL_KURIKULUM
  VICE_PRINCIPAL_KESISWAAN
  HEAD_MANAGEMENT
  IT
  PR
  ACC
  TEACHER
  STAFF
  HRD
  KARYAWAN
  STUDENT
}

enum sdevaluation_type {
  PEER
  SUPERVISOR
  KOORDINATOR
  STUDENT
}

enum evalperiod_status {
  DRAFT
  OPEN
  CLOSED
}

enum teacherassignment_role {
  SUPERVISOR
  PEER
  KOORDINATOR
}
