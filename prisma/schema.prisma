generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model evaluationlog {
  id                                        String   @id @default(uuid())
  graderId                                  String
  targetId                                  String
  rubricId                                  String
  createdAt                                 DateTime @default(now())
  user_evaluationlog_graderIdTouser user    @relation("evaluationlog_graderIdTouser", fields: [graderId], references: [id], onDelete: Cascade, map: "EvaluationLog_graderId_fkey")
  rubric                                    rubric   @relation(fields: [rubricId], references: [id], onDelete: Cascade, map: "EvaluationLog_rubricId_fkey")
  user_evaluationlog_targetIdTouser user    @relation("evaluationlog_targetIdTouser", fields: [targetId], references: [id], onDelete: Cascade, map: "EvaluationLog_targetId_fkey")

  @@unique([graderId, targetId, rubricId], map: "EvaluationLog_graderId_targetId_rubricId_key")
  @@index([rubricId], map: "EvaluationLog_rubricId_fkey")
  @@index([targetId], map: "EvaluationLog_targetId_fkey")
}

model rubric {
  id               String          @id @default(uuid())
  title            String
  description      String?
  evaluators       String?
  evaluatees       String?
  isSelfReflection Boolean         @default(false) 
  intendedForRole  String          @default("STUDENT") 
  schoolLevel      String          @default("SMP_SMA") // SD | SMP_SMA
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  evaluationlog    evaluationlog[]
  rubricsection    rubricsection[]
}

model rubriccategory {
  id              String            @id @default(uuid())
  title           String
  order           Int
  sectionId       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  rubricsection   rubricsection     @relation(fields: [sectionId], references: [id], onDelete: Cascade, map: "RubricCategory_sectionId_fkey")
  rubricindicator rubricindicator[]

  @@index([sectionId], map: "RubricCategory_sectionId_fkey")
}

model rubricindicator {
  id             String         @id @default(uuid())
  text           String
  order          Int
  weight         Float          @default(1)
  categoryId     String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  rubriccategory rubriccategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "RubricIndicator_categoryId_fkey")
  score          score[]

  @@index([categoryId], map: "RubricIndicator_categoryId_fkey")
}

model rubricsection {
  id             String           @id @default(uuid())
  title          String
  order          Int
  rubricId       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  rubriccategory rubriccategory[]
  rubric         rubric           @relation(fields: [rubricId], references: [id], onDelete: Cascade, map: "RubricSection_rubricId_fkey")

  @@index([rubricId], map: "RubricSection_rubricId_fkey")
}

model score {
  id                        String          @id @default(uuid())
  value                     score_value
  targetId                  String
  graderId                  String
  indicatorId               String
  createdAt                 DateTime        @default(now())
  user_score_graderIdTouser user            @relation("score_graderIdTouser", fields: [graderId], references: [id], onDelete: Cascade, map: "Score_graderId_fkey")
  rubricindicator           rubricindicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade, map: "Score_indicatorId_fkey")
  user_score_targetIdTouser user            @relation("score_targetIdTouser", fields: [targetId], references: [id], onDelete: Cascade, map: "Score_targetId_fkey")

  @@unique([targetId, graderId, indicatorId], map: "Score_targetId_graderId_indicatorId_key")
  @@index([graderId], map: "Score_graderId_fkey")
  @@index([indicatorId], map: "Score_indicatorId_fkey")
}

model user {
  id                                         String           @id @default(uuid())
  name                                       String
  nis_niy                                    String           @unique(map: "User_nis_niy_key")
  password                                   String
  role                                       user_role
  email                                      String?
  gender                                     String?
  department                                 user_department? @default(UMUM)
  
  grade                                      Int?             // 7, 8, 9, 10, 11, 12
  level                                      String?          // "SMP" or "SMA"
  className                                  String?          // (e.g., "9A", "10.1")

  evaluationlog_evaluationlog_graderIdTouser evaluationlog[]  @relation("evaluationlog_graderIdTouser")
  evaluationlog_evaluationlog_targetIdTouser evaluationlog[]  @relation("evaluationlog_targetIdTouser")
  score_score_graderIdTouser                 score[]          @relation("score_graderIdTouser")
  score_score_targetIdTouser                 score[]          @relation("score_targetIdTouser")

  sdMemberships               GroupMember[]
  supervisingAssignments      SupervisorAssignment[] @relation("SupSupervisor")
  supervisedAssignments       SupervisorAssignment[] @relation("SupTeacher")
  studentAssignmentsAsStudent StudentAssignment[]    @relation("SaStudent")
  studentAssignmentsAsTeacher StudentAssignment[]    @relation("SaTeacher")
  sdEvalsGiven                SdEvaluation[]         @relation("SdEvalEvaluator")
  sdEvalsReceived             SdEvaluation[]         @relation("SdEvalTarget")

  @@index([role]) // 🚀 This makes filtering students on your dedicated page lightning fast!
}

enum user_department {
  IPA
  IPS
  UMUM
}

enum score_value {
  A
  B
  C
  D
}

model Observation {
  id               String   @id @default(cuid())
  targetId         String
  targetName       String
  observerId       String
  observerName     String
  date             String
  kelas            String
  subject          String
  duration         String
  topic            String
  scores           Json
  notesPositive    String   @db.Text
  notesImprovement String   @db.Text
  finalScore       Float
  isApproved       Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model ObservationTemplate {
  id      String @id @default(cuid())
  content Json
}

enum user_role {
  ADMIN
  DIRECTOR
  PRINCIPAL
  VICE_PRINCIPAL_KURIKULUM
  VICE_PRINCIPAL_KESISWAAN
  TEACHER
  STAFF
  HRD      
  KARYAWAN
  STUDENT
}

model Absence {
  id              String   @id @default(cuid())
  userId          String   
  userName        String
  role            String
  attendanceScore Float    @default(0) 
  updatedAt       DateTime @updatedAt
}

model EvaluationWeight {
  id                String   @id // e.g., "Teacher", "Staff", "Karyawan", "Vice-Principal", "Director/Principal"
  studentWeight     Float    @default(20)
  peerWeight        Float    @default(20)
  selfWeight        Float    @default(20)
  observationWeight Float    @default(20)
  attendanceWeight Float    @default(20)
  // SD / TK only: main evaluation (peer, self, supervisor, leaders) and its internal split
  mainWeight        Float    @default(0)
  supervisorWeight  Float    @default(0)
  leaderWeight      Float    @default(0)
  updatedAt         DateTime @updatedAt
}

model SemesterArchive {
  id               String   @id @default(uuid())
  semester         String   // e.g., "Ganjil 2026/2027"
  targetId         String
  targetName       String
  targetRole       String
  scoresData       Json?    // Snapshot of all 'score' rows
  evalLogsData     Json?    // Snapshot of all 'evaluationlog' rows
  observationsData Json?    // Snapshot of all 'Observation' rows
  absenceData      Json?    // Snapshot of 'Absence' row
  archivedAt       DateTime @default(now())

  @@index([semester])
  @@index([targetId])
}

model PerformanceWeight {
  id          String   @id @default(uuid())
  factorKey   String   @unique // e.g., 'STUDENT', 'PEER', 'SELF', 'OBSERVATION', 'ATTENDANCE'
  displayName String   // e.g., 'Student Evaluation'
  weight      Float    // e.g., 0.25 (representing 25%)
  description String?
  updatedAt   DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorName  String
  actorRole  String
  action     String
  entityType String
  entityId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}


// ───────────── SD teacher evaluation system ─────────────

enum SdSubject {
  MATEMATIKA
  IPA
  BAHASA_INDONESIA
  PPKN
}

enum PeriodStatus {
  DRAFT
  OPEN
  CLOSED
}

enum GroupStatus {
  DRAFT
  PUBLISHED
  INACTIVE
}

enum SdEvalType {
  PEER
  SUPERVISOR
  STUDENT
}

model EvalPeriod {
  id          String       @id @default(uuid())
  name        String       @unique
  status      PeriodStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  groups      TeacherGroup[]
  supervisors SupervisorAssignment[]
  students    StudentAssignment[]
  evaluations SdEvaluation[]
}

// A group has exactly two distinct classes (classOne / classTwo). Teacher count is flexible.
model TeacherGroup {
  id          String      @id @default(uuid())
  name        String
  periodId    String
  classOne    String
  classTwo    String
  level       String?     // TK | SD — which school owns the group
  status      GroupStatus @default(DRAFT)
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  period      EvalPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  evaluations SdEvaluation[]

  @@unique([periodId, name])
  @@index([periodId])
}

// One teacher teaching one subject in one class of the group. Category (EXACT / NON-EXACT) comes from the subject.
model GroupMember {
  id        String      @id @default(uuid())
  groupId   String
  teacherId String
  className String
  subject   SdSubject
  partnerId String?     @unique
  createdAt DateTime    @default(now())
  group     TeacherGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher   user         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  partner   GroupMember? @relation("Partner", fields: [partnerId], references: [id], onDelete: SetNull)
  partnerOf GroupMember? @relation("Partner")

  @@unique([groupId, className, subject])
  @@index([teacherId])
}

model SupervisorAssignment {
  id           String     @id @default(uuid())
  periodId     String
  supervisorId String
  teacherId    String
  active       Boolean    @default(true)
  assignedById String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  period       EvalPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  supervisor   user       @relation("SupSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)
  teacher      user       @relation("SupTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  evaluations  SdEvaluation[]

  @@unique([periodId, supervisorId, teacherId])
  @@index([supervisorId])
  @@index([teacherId])
}

model StudentAssignment {
  id           String     @id @default(uuid())
  periodId     String
  studentId    String
  teacherId    String
  assignedById String
  createdAt    DateTime   @default(now())
  period       EvalPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  student      user       @relation("SaStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher      user       @relation("SaTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  evaluations  SdEvaluation[]

  @@unique([periodId, studentId, teacherId])
  @@index([studentId])
  @@index([teacherId])
}

// Peer, supervisor and student evaluations live in one table, always distinguished by `type`.
// `context` is a snapshot (class, subject, category, partner flag) so later reassignment never rewrites history.
model SdEvaluation {
  id                     String       @id @default(uuid())
  type                   SdEvalType
  periodId               String
  evaluatorId            String
  targetId               String
  groupId                String?
  supervisorAssignmentId String?
  studentAssignmentId    String?
  rubricId               String
  answers                Json
  average                Float
  context                Json?
  status                 String       @default("SUBMITTED")
  submittedAt            DateTime     @default(now())
  period                 EvalPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  evaluator              user         @relation("SdEvalEvaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)
  target                 user         @relation("SdEvalTarget", fields: [targetId], references: [id], onDelete: Cascade)
  group                  TeacherGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  supervisorAssignment   SupervisorAssignment? @relation(fields: [supervisorAssignmentId], references: [id], onDelete: Restrict)
  studentAssignment      StudentAssignment?    @relation(fields: [studentAssignmentId], references: [id], onDelete: Restrict)

  @@unique([type, periodId, evaluatorId, targetId])
  @@index([targetId])
  @@index([evaluatorId])
  @@index([periodId, type])
}
