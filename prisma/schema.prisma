generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model evaluationlog {
  id                                         String   @id @default(uuid())
  graderId                                   String
  targetId                                   String
  rubricId                                   String
  createdAt                                  DateTime @default(now())
  user_evaluationlog_graderIdTouser user     @relation("evaluationlog_graderIdTouser", fields: [graderId], references: [id], onDelete: Cascade, map: "EvaluationLog_graderId_fkey")
  rubric                                     rubric   @relation(fields: [rubricId], references: [id], onDelete: Cascade, map: "EvaluationLog_rubricId_fkey")
  user_evaluationlog_targetIdTouser user     @relation("evaluationlog_targetIdTouser", fields: [targetId], references: [id], onDelete: Cascade, map: "EvaluationLog_targetId_fkey")

  @@unique([graderId, targetId, rubricId], map: "EvaluationLog_graderId_targetId_rubricId_key")
  @@index([rubricId], map: "EvaluationLog_rubricId_fkey")
  @@index([targetId], map: "EvaluationLog_targetId_fkey")
}

model rubric {
  id              String          @id @default(uuid())
  title           String
  description     String?
  evaluators      String?
  evaluatees      String?
  
  // ---> THE NEW DATABASE LOCK IS HERE <---
  intendedForRole String          @default("STUDENT") 
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  evaluationlog   evaluationlog[]
  rubricsection   rubricsection[]
}

model rubriccategory {
  id              String            @id @default(uuid())
  title           String
  order           Int
  sectionId       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  rubricsection   rubricsection     @relation(fields: [sectionId], references: [id], onDelete: Cascade, map: "RubricCategory_sectionId_fkey")
  rubricindicator rubricindicator[]

  @@index([sectionId], map: "RubricCategory_sectionId_fkey")
}

model rubricindicator {
  id             String         @id @default(uuid())
  text           String
  order          Int
  weight         Float          @default(1)
  categoryId     String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  rubriccategory rubriccategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "RubricIndicator_categoryId_fkey")
  score          score[]

  @@index([categoryId], map: "RubricIndicator_categoryId_fkey")
}

model rubricsection {
  id             String           @id @default(uuid())
  title          String
  order          Int
  rubricId       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  rubriccategory rubriccategory[]
  rubric         rubric           @relation(fields: [rubricId], references: [id], onDelete: Cascade, map: "RubricSection_rubricId_fkey")

  @@index([rubricId], map: "RubricSection_rubricId_fkey")
}

model score {
  id                        String          @id @default(uuid())
  value                     score_value
  targetId                  String
  graderId                  String
  indicatorId               String
  createdAt                 DateTime        @default(now())
  user_score_graderIdTouser user            @relation("score_graderIdTouser", fields: [graderId], references: [id], onDelete: Cascade, map: "Score_graderId_fkey")
  rubricindicator           rubricindicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade, map: "Score_indicatorId_fkey")
  user_score_targetIdTouser user            @relation("score_targetIdTouser", fields: [targetId], references: [id], onDelete: Cascade, map: "Score_targetId_fkey")

  @@unique([targetId, graderId, indicatorId], map: "Score_targetId_graderId_indicatorId_key")
  @@index([graderId], map: "Score_graderId_fkey")
  @@index([indicatorId], map: "Score_indicatorId_fkey")
}

model user {
  id                                         String           @id @default(uuid())
  name                                       String
  nis_niy                                    String           @unique(map: "User_nis_niy_key")
  password                                   String
  role                                       user_role
  email                                      String?
  gender                                     String?
  department                                 user_department? @default(UMUM)
  
  grade                                      Int?             // 7, 8, 9, 10, 11, 12
  level                                      String?          // "SMP" or "SMA"
  className                                  String?          // <--- ADD THIS (e.g., "9A", "10.1")

  evaluationlog_evaluationlog_graderIdTouser evaluationlog[]  @relation("evaluationlog_graderIdTouser")
  evaluationlog_evaluationlog_targetIdTouser evaluationlog[]  @relation("evaluationlog_targetIdTouser")
  score_score_graderIdTouser                 score[]          @relation("score_graderIdTouser")
  score_score_targetIdTouser                 score[]          @relation("score_targetIdTouser")
}

// ADDED: The department enum
enum user_department {
  IPA
  IPS
  UMUM
}

enum score_value {
  A
  B
  C
  D
}

enum user_role {
  ADMIN
  DIRECTOR
  PRINCIPAL
  TEACHER
  STAFF
  STUDENT
}